# Tên biến môi trường app cần — CHỈ tên, không bao giờ ghi giá trị vào file này (file được commit).
# Giá trị thật: local ở .env.local (gitignore) · production ở Vercel › Project › Settings › Environment Variables.
# deploy_preflight.py so danh sách này với mọi process.env.* trong code.

# Đọc Google Sheets (service account, quyền spreadsheets.readonly)
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Đăng nhập Google (NextAuth v4)
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
ALLOWED_EMAILS=
# local: http://localhost:3000 · production: URL Vercel chính thức (phải khớp redirect URI của OAuth client)
NEXTAUTH_URL=
